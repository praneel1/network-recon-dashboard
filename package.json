{
  "name": "portatlas-recon-dashboard",
  "version": "1.0.0",
  "author": "PortAtlas",
  "description": "PortAtlas Network Reconnaissance Desktop Dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:py": "uv pip install pyinstaller && .\\.venv\\Scripts\\pyinstaller.exe --noconfirm --clean --distpath dist-python portatlas.spec",
    "dist": "npm run build:py && electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "wait-port": "1.1.0"
  },
  "build": {
    "appId": "com.portatlas.dashboard",
    "productName": "PortAtlas",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "loading.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-python/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "PortAtlas.exe",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    }
  }
}